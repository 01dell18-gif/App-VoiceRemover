# FYJ Channel Voice - Environment Configuration
# Salin file ini menjadi .env untuk mengaktifkan konfigurasi domain dan server:
# Windows CMD : copy .env.example .env
# Linux / Mac : cp .env.example .env

# =====================================================================
# 1. KONFIGURASI PORT & JARINGAN
# =====================================================================
# Port server aplikasi (Default: 3032)
# Gunakan 80 jika ingin akses HTTP langsung, atau 443 untuk HTTPS langsung
PORT=3032

# Host binding (0.0.0.0 mengikat ke semua kartu jaringan agar dapat diakses dari domain & HP)
HOST=0.0.0.0

# Environment mode: production / development
NODE_ENV=production

# =====================================================================
# 2. KONFIGURASI DOMAIN
# =====================================================================
# Masukkan nama domain Anda (tanpa https:// dan tanpa slash)
# Contoh: suara.domainanda.com atau pemisahvokal.id
DOMAIN=

# URL lengkap publik aplikasi Anda (opsional, otomatis dibuat dari DOMAIN jika kosong)
# Contoh: https://suara.domainanda.com
APP_URL=

# =====================================================================
# 3. REVERSE PROXY & CORS (Nginx, Cloudflare Tunnel, Caddy, Apache)
# =====================================================================
# Trust proxy headers (1 = percaya 1 hop proxy, atau true)
# Sangat penting agar deteksi IP dan WebSocket Socket.IO bekerja di balik domain/Nginx/Cloudflare
TRUST_PROXY=1

# CORS Allowed Origins (* untuk mengizinkan semua domain, atau sebutkan domain Anda)
# Contoh: https://suara.domainanda.com,https://www.domainanda.com
CORS_ORIGIN=*

# =====================================================================
# 4. KONFIGURASI SSL / HTTPS LANGSUNG (OPSIONAL)
# =====================================================================
# Aktifkan jika Anda ingin Node.js menangani sertifikat SSL secara langsung
# tanpa menggunakan Nginx / Caddy / Cloudflare.
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=

# Otomatis mengalihkan HTTP (port 80) ke HTTPS (port 443) jika SSL aktif
REDIRECT_HTTP=false
HTTP_PORT=80

# =====================================================================
# 5. PATH PYTHON KUSTOM (OPSIONAL)
# =====================================================================
# Tentukan path python jika diinstal di direktori khusus
# PYTHON_PATH=C:\Users\Username\AppData\Local\Programs\Python\Python311\python.exe
