# Force Windows CRLF line endings for batch files and PowerShell scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Auto detect text files and perform LF normalization for code
* text=auto

# Binary files
*.zip binary
*.whl binary
*.exe binary
*.msi binary
*.onnx binary
*.png binary
*.jpg binary
*.ico binary

